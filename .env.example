# ──────────────────────────────────────────────
# CareerOS — Environment Variables
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# ── Server ─────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ───────────────────────────────────
# MongoDB Atlas URI (required)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/careeros?retryWrites=true&w=majority

# ── Auth ───────────────────────────────────────
# A long random secret for signing JWTs
JWT_SECRET=your_super_secret_jwt_key_here

# ── AI Provider ────────────────────────────────
# Which provider to use first: gemini | grok | openai | openrouter
# Leave unset or set to "fallback" to use fallback mode (no AI key needed)
AI_PROVIDER=gemini

# ── Gemini (Google) ────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ── Grok (xAI) ─────────────────────────────────
GROK_API_KEY=
GROK_MODEL=grok-3-mini

# ── OpenAI ─────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── OpenRouter ─────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ── CORS (Vercel + Render deployment) ──────────
# Set this to your Vercel frontend URL in production
# e.g. https://careeros.vercel.app
CLIENT_URL=http://localhost:3000

# ── Static File Serving ────────────────────────
# Set to "true" if you want Render to also serve the frontend
# (Option A: single server). Leave unset for Option B (Vercel+Render)
# SERVE_STATIC=true
